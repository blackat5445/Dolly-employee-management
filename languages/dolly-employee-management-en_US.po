msgstr "Run checks now"

#: assets/js/dolly-admin.js:2282
msgid "Controlli eseguiti."
msgstr "Checks run."

#: assets/js/dolly-admin.js:2285 assets/js/dolly-admin.js:3536
msgid "Invia email di prova"
msgstr "Send test email"

#: assets/js/dolly-admin.js:2291 assets/js/dolly-admin.js:3532
msgid "Stato del sistema"
msgstr "System status"

#: assets/js/dolly-admin.js:2293 assets/js/dolly-admin.js:3543
