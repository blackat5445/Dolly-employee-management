msgstr "Aspetto predefinito ripristinato."

#: assets/js/dolly-admin.js:2946
msgid "Brand"
msgstr "Marchio"

#: assets/js/dolly-admin.js:2946
msgid "While they keep their default values, the subtitles, the panel name and the sign-in page texts are shown in each user's language."
msgstr "Finché restano quelli predefiniti, sottotitoli, nome del pannello e testi della pagina di accesso vengono mostrati nella lingua di ogni utente."

#: assets/js/dolly-admin.js:2947
msgid "Logo and icon"
msgstr "Logo e icona"

#: assets/js/dolly-admin.js:2948
msgid "Colors"
msgstr "Colori"

#: assets/js/dolly-admin.js:2949 assets/js/dolly-admin.js:3265
